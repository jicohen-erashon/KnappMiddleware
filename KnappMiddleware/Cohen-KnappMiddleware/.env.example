# Copiar a .env (no versionado) y completar con valores reales antes de levantar el stack.
# Stack 100% standalone: este compose levanta su propio Postgres y su propio RabbitMQ, no depende
# de ningun contenedor ni red externos.

POSTGRES_DB=Middleware
POSTGRES_USER=iadministrator
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_PORT=5432

# Ruta local (host) al checkout del repo de migraciones (carpeta db/migrations). Si se deja vacio,
# Postgres arranca sin esquema y hay que aplicar las migraciones a mano.
MIGRATIONS_PATH=./migrations

# Opcional: si se definen, seed-admin.sh crea este SuperUsuario en el primer arranque de Postgres
# (volumen vacio). Sin definir, no se crea ningun usuario automaticamente.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=SuperUsuario

RABBITMQ_USER=knapp
RABBITMQ_PASSWORD=cambiar_esta_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MIDDLEWARE_PORT=5231

# Endpoint de Loki/Grafana existente (no se levanta en este compose). Si no hay uno disponible,
# dejar el default: Program.cs descarta los fallos de envio a Loki sin bloquear el arranque.
LOKI_ENDPOINT=http://srv-bidev:3100

ASPNETCORE_ENVIRONMENT=Production
