<?xml version="1.0" encoding="utf-8" ?>
<!--
  nlog.config — KnappMiddleware
  Migrado desde Serilog. Sinks:
    - Console
    - File con rotación diaria y retención de 30 días en ${var:logFilePath}
    - Loki (push HTTP al endpoint configurado en appsettings.json Loki:Endpoint)
  Las variables logFilePath, lokiEndpoint y environment se inyectan desde Program.cs.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn">

  <variable name="logFilePath" value="${basedir}/logs" />
  <variable name="lokiEndpoint" value="http://loki:3100" />
  <variable name="environment" value="Production" />

  <targets>
    <target name="console" xsi:type="Console"
            layout="${longdate} ${level:uppercase=true} ${logger} ${message} ${exception:format=tostring}" />

    <target name="file" xsi:type="File"
            fileName="${var:logFilePath}/log-${shortdate}.txt"
            archiveFileName="${var:logFilePath}/archives/log-{#}.txt"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="30"
            keepFileOpen="false"
            layout="${longdate} ${level:uppercase=true} ${logger} ${message} ${exception:format=tostring}" />

    <target name="loki" xsi:type="Loki"
            endpoint="${var:lokiEndpoint}"
            batchSize="200"
            taskDelayMilliseconds="1000">
      <label name="app" layout="KnappMiddleware" />
      <label name="env" layout="${var:environment}" />
      <label name="level" layout="${level:uppercase=true}" />
      <label name="logger" layout="${logger}" />
    </target>
  </targets>

  <rules>
    <logger name="*" minLevel="Info" writeTo="console,file,loki" />
  </rules>
</nlog>
