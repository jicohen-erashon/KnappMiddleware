{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/envelope.schema.json",
  "title": "Sobre (envelope) SAP → middleware",
  "description": "Bloque común que SAP adjunta en cada telegrama (mismo nivel JSON que los campos de negocio — NO anidado). Los identificadores válidos son los documentados en HIS §3/§4. Falta 1XR/2XR (ver README): NO aparece todavía en la spec V2.",
  "type": "object",
  "$defs": {
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telid",
        "idrecord",
        "idrecordstatus",
        "direction",
        "objecttype",
        "objectid",
        "tecreateddateon",
        "tecreatedtimeon",
        "tecreatedby",
        "temodifieddateon",
        "temodifiedtimeon",
        "temodifiedby",
        "sentdate",
        "senttime",
        "status",
        "warehousenumber"
      ],
      "properties": {
        "telid": {
          "type": "string",
          "maxLength": 32
        },
        "idrecord": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[12][0-9A-Z]{2}$"
        },
        "idrecordstatus": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[24][0-9A-Z]{2}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "HK",
            "KH"
          ]
        },
        "objecttype": {
          "type": "string",
          "enum": [
            "ORDER",
            "ARTICLE",
            "PARTNER",
            "ROUTE",
            "INVENTORY",
            "REQUEST",
            "STOCK"
          ]
        },
        "objectid": {
          "type": "string",
          "maxLength": 32
        },
        "tecreateddateon": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9\\-‑]{10}$"
        },
        "tecreatedtimeon": {
          "type": "string",
          "pattern": "^[0-9:\\-]{5,12}$"
        },
        "tecreatedby": {
          "type": "string",
          "maxLength": 64
        },
        "temodifieddateon": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9\\-‑]{10}$"
        },
        "temodifiedtimeon": {
          "type": "string",
          "pattern": "^[0-9:\\-]{5,12}$"
        },
        "temodifiedby": {
          "type": "string",
          "maxLength": 64
        },
        "sentdate": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9\\-‑]{10}$"
        },
        "senttime": {
          "type": "string",
          "pattern": "^[0-9:\\-]{5,12}$"
        },
        "status": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "warehousenumber": {
          "type": "string",
          "pattern": "^[0-9]{3,5}$"
        }
      }
    }
  }
}
