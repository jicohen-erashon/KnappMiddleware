{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/stock-change-result.schema.json",
  "title": "3UU — Resultado de modificación de stock (KiSoft → Host, 9802)",
  "description": "HISP §4.4.3. Acuse 4UU. Estado '01' = aplicado · '02' = rechazado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["loadunit", "station", "slotstates"],
  "properties": {
    "loadunit": { "type": "string", "minLength": 1, "maxLength": 6 },
    "station":  { "$ref": "https://knapp.local/schemas/common/station.schema.json", "description": "Mismas que 1UU." },
    "geocode":  { "type": "string", "maxLength": 12 },
    "slotstates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "state"],
        "properties": {
          "slot":  { "type": "integer", "minimum": 1, "maximum": 8 },
          "state": { "type": "string", "enum": ["01","02"], "description": "01=OK, 02=rechazado." }
        }
      }
    }
  }
}
