{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/order-response.schema.json",
  "title": "32R — Respuesta de pedido (KiSoft → Host, 9802)",
  "description": "HISP §4.1. Es el evento principal del flujo asíncrono. Acuse 42R (≤ 10 s). Para entradas 12N incluye hoja del pedido inicial y máximo de hojas conocidas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "ordernumber", "sheetnumber", "ordertype"],
  "properties": {
    "mandtk":        { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "ordernumber":   { "type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[A-Za-z0-9_-]+$" },
    "sheetnumber":   { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^\\d{4}$", "description": "0001..0999 ó 1000..9999 (cajas adicionales)." },
    "ordertype":     { "$ref": "https://knapp.local/schemas/common/order-type.schema.json" },
    "initsheetnumber":{ "type": ["string", "null"], "pattern": "^\\d{4}$", "description": "Solo cuando vienen cajas adicionales (f)." },
    "knownsheetcount":{ "type": "string", "pattern": "^\\d{4}$", "description": "A. Número de hoja más alto conocido." },
    "transmittedtosystem":{ "type": "string", "pattern": "^\\d{4}$", "description": "Transmitido a KNAPP." },
    "startingpoint": { "type": "string", "enum": ["190", "199"], "description": "B. Punto de arranque: OS001 o BULK001." },
    "loadmedium":    { "$ref": "https://knapp.local/schemas/common/loadmedium.schema.json", "description": "C. Medio de carga usado." },
    "loadunit":      { "type": ["string", "null"], "maxLength": 8, "description": "D. UC utilizada." },
    "businesspartner":{ "type": ["string", "null"], "maxLength": 12, "description": "E." },
    "ramp":          { "type": "string", "pattern": "^0{4}[0-9]$", "description": "G. Rampa: 00001..00010 (DIS001), 00021..00025 (DIS002), 00011/00025 (errores)." },
    "starttime":     { "type": ["string", "null"], "format": "date-time", "description": "s. YYYYMMDDhhmmss." },
    "endtime":       { "type": ["string", "null"], "format": "date-time", "description": "e." },
    "lastreading": {
      "type": ["object", "null"],
      "description": "t. Estación por la que pasó o se desvió.",
      "properties": {
        "station": { "type": "string", "enum": ["190","091","092","094","010","011","095","027","083","183","184"] },
        "time":    { "type": "string", "format": "date-time" },
        "state":   { "type": "string", "enum": ["0","1"], "description": "0=pasó sin desvío · 1=desviada/procesada." }
      }
    },
    "orderstates": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "string",
        "pattern": "^\\d{4}$",
        "oneOf": [
          { "const": "0000", "description": "Pedido creado" },
          { "const": "0001", "description": "Pedido arrancado" },
          { "const": "0002", "description": "Finalizado normalmente" },
          { "const": "0003", "description": "Cancelado por GUI KiSoft One" },
          { "const": "0004", "description": "Cancelado por Host" },
          { "const": "0005", "description": "Finalizado por timeout" },
          { "const": "0010", "description": "Última UC de la entrega" }
        ]
      },
      "description": "O. Lista acumulativa de estados."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": { "$ref": "order-response-line.schema.json" },
      "description": "Z. Líneas de pedido procesadas."
    },
    "remaininglines": {
      "type": ["array", "null"],
      "maxItems": 99,
      "items": { "$ref": "order-response-remaining.schema.json" },
      "description": "b. Líneas aún no asignadas a UC."
    }
  }
}
