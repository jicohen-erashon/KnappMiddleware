{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/stock-adjustment.schema.json",
  "title": "3SC — Ajuste de stock (KiSoft → Host, 9802)",
  "description": "HISP §4.4.1. Diferencia de stock detectada en inventario o evento. Para bloqueos/desbloqueos ver también stockadjustment.message_type=41/42. Acuse 4SC. Número de pedido en rango SC00000001..SC99999999 (no utilizar ese rango en otros flujos).",
  "type": "object",
  "additionalProperties": false,
  "required": ["scnumber", "station", "messagetype", "loadunit", "productnumber", "packsize", "stocktype", "difference"],
  "properties": {
    "scnumber":       { "type": "string", "pattern": "^SC[0-9]{8}$" },
    "station":        { "$ref": "https://knapp.local/schemas/common/station.schema.json", "description": "Subsistema que originó el ajuste (065 OSR, 001-004, 010-011, 199)." },
    "messagetype": {
      "type": "string",
      "enum": ["40","41","42","43","45"],
      "description": "40=stock recepcionado · 41=bloqueo añadido · 42=bloqueo retirado · 43=stock corregido · 45=stock reasignado."
    },
    "loadunit":       { "type": "string", "minLength": 1, "maxLength": 6 },
    "slotnumber":     { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
    "mandtk":         { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "productnumber":  { "type": "string", "maxLength": 12 },
    "packsize":       { "type": "string", "pattern": "^\\d{4}$" },
    "stocktype":      { "$ref": "https://knapp.local/schemas/common/stock-type.schema.json" },
    "batchnumber":    { "type": ["string", "null"], "maxLength": 20 },
    "expirationdate": { "type": ["string", "null"], "format": "date" },
    "stockquality":   { "type": ["string", "null"], "enum": ["1","2"] },
    "modifiedblockreason": { "type": ["string", "null"], "$ref": "https://knapp.local/schemas/common/block-reason.schema.json" },
    "currentblockreasons": {
      "type": "array",
      "maxItems": 99,
      "items": { "$ref": "https://knapp.local/schemas/common/block-reason.schema.json" },
      "description": "Lista de motivos de bloqueo actuales tras el ajuste."
    },
    "reason": {
      "type": "string",
      "maxLength": 15,
      "oneOf": [
        { "const": "FOUND" },
        { "const": "LOST" },
        { "const": "HOST" },
        { "const": "SUBSISTEMA" },
        { "const": "SISTEMA" },
        { "const": "OSR_not_empty" },
        { "const": "under_pick" },
        { "const": "inventory" },
        { "const": "damaged_tray" }
      ]
    },
    "reasonadditional": { "type": ["string", "null"], "maxLength": 30 },
    "time":             { "type": "string", "format": "date-time" },
    "warehouseoperator":{ "type": "string", "maxLength": 8 },
    "difference":       {
      "type": "object",
      "additionalProperties": false,
      "required": ["sign", "value"],
      "properties": {
        "sign":  { "type": "string", "enum": ["+","-"] },
        "value": { "type": "integer", "minimum": 1, "maximum": 9999 }
      }
    }
  }
}
