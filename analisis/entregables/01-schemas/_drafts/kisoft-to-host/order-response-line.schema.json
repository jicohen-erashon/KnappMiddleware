{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/order-response-line.schema.json",
  "title": "Línea de respuesta de pedido (en 32R)",
  "description": "HISP §4.1.5.13. Estado de línea (dos dígitos) — ver tabla de estados.",
  "type": "object",
  "additionalProperties": false,
  "required": ["productnumber", "packsize", "stocktype", "quantity"],
  "properties": {
    "linereference": { "type": ["string", "null"], "maxLength": 20 },
    "productnumber":  { "type": "string", "minLength": 1, "maxLength": 12 },
    "packsize":       { "type": "string", "pattern": "^\\d{4}$" },
    "stocktype":      { "$ref": "https://knapp.local/schemas/common/stock-type.schema.json" },
    "batchnumber":    { "type": ["string", "null"], "maxLength": 20 },
    "expirationdate": { "type": ["string", "null"], "format": "date" },
    "reservationcode":{ "type": ["string", "null"], "maxLength": 10 },
    "sign":           { "type": "string", "enum": ["+","-"], "description": "Signo del número preparado vs. nominal." },
    "quantity":       { "type": "integer", "minimum": 1, "maximum": 9999 },
    "stockquality":   { "type": "string", "enum": ["1","2"] },
    "linestate": {
      "type": "string",
      "pattern": "^\\d{2}$",
      "description": "Ver códigos 01..93.",
      "oneOf": [
        { "const": "01", "description": "Aún no preparada" },
        { "const": "30", "description": "Procesada correctamente" },
        { "const": "50", "description": "Error técnico (eyector defectuoso, error recuento)" },
        { "const": "51", "description": "Cantidad insuficiente o excedente" },
        { "const": "52", "description": "Corregida en estación de control" },
        { "const": "53", "description": "Artículo desconocido" },
        { "const": "54", "description": "Cantidad nominal = 0" },
        { "const": "55", "description": "Cantidad > máxima" },
        { "const": "56", "description": "UC llena" },
        { "const": "57", "description": "OFF SALE" },
        { "const": "58", "description": "OUT OF STOCK" },
        { "const": "59", "description": "ARTICLE IS BLOCKED" },
        { "const": "60", "description": "VOLUMETRIX sin tamaño adecuado" },
        { "const": "65", "description": "Vision Central Belt error" },
        { "const": "93", "description": "Borrada por Host" }
      ]
    },
    "warehouseoperator": { "type": ["string", "null"], "maxLength": 8 },
    "processingtime":    { "type": ["string", "null"], "format": "date-time" },
    "originloadunit":    { "type": ["string", "null"], "maxLength": 6 },
    "originslotnumber":  { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
    "serialnumber":      { "type": ["string", "null"], "maxLength": 20 },
    "geocode":           { "type": ["string", "null"], "maxLength": 12 }
  }
}
