{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/inventory-response.schema.json",
  "title": "3IR — Respuesta de inventario (KiSoft → Host, 9802)",
  "description": "HISP §4.2. Acuse 4IR. Estado 0002=normal · 0003=cancelado por GUI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "inventoryrequestnumber", "states"],
  "properties": {
    "mandtk":                 { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "inventoryrequestnumber": { "type": "string", "minLength": 1, "maxLength": 7 },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": { "type": "string", "pattern": "^(0002|0003)$" }
    },
    "lines": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["station", "productnumber", "packsize", "stocktype", "quantity", "stockquality"],
        "properties": {
          "station":        { "$ref": "https://knapp.local/schemas/common/station.schema.json" },
          "productnumber":  { "type": "string", "maxLength": 12 },
          "packsize":       { "type": "string", "pattern": "^\\d{4}$" },
          "stocktype":      { "$ref": "https://knapp.local/schemas/common/stock-type.schema.json" },
          "batchnumber":    { "type": "string", "maxLength": 20 },
          "expirationdate": { "type": "string", "format": "date" },
          "quantity":       { "type": "integer", "minimum": 1, "maximum": 9999 },
          "stockquality":   { "type": "string", "enum": ["1","2"] },
          "processingnote": { "type": "string", "maxLength": 99 },
          "loadmedium":     { "$ref": "https://knapp.local/schemas/common/loadmedium.schema.json" },
          "loadunit":       { "type": "string", "maxLength": 6 },
          "slotnumber":     { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
          "blockstatus":    { "type": "string", "maxLength": 30 },
          "linestate":      { "type": "string", "const": "01" },
          "warehouseoperator":{ "type": "string", "maxLength": 8 },
          "processingtime": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
