{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/kisoft-to-host/order-response-remaining.schema.json",
  "title": "Línea pendiente de asignación (bloque b en 32R)",
  "description": "HISP §4.1.5.13. Líneas que aún no están en una UC de destino.",
  "type": "object",
  "additionalProperties": false,
  "required": ["station", "productnumber", "packsize", "stocktype", "quantity"],
  "properties": {
    "linereference":     { "type": ["string", "null"], "maxLength": 20 },
    "station":           { "type": "string", "const": "065", "description": "OSR1 (única en estado b)." },
    "productnumber":     { "type": "string", "minLength": 1, "maxLength": 12 },
    "packsize":          { "type": "string", "pattern": "^\\d{4}$" },
    "stocktype":         { "$ref": "https://knapp.local/schemas/common/stock-type.schema.json" },
    "batchnumber":       { "type": ["string", "null"], "maxLength": 20 },
    "expirationdate":    { "type": ["string", "null"], "format": "date" },
    "reservationcode":   { "type": ["string", "null"], "maxLength": 10 },
    "quantity":          { "type": "integer", "minimum": 1, "maximum": 9999 },
    "stockquality":      { "type": "string", "enum": ["1","2"] },
    "destinationloadmedium": { "$ref": "https://knapp.local/schemas/common/loadmedium.schema.json" },
    "destinationloadunit":   { "type": "string", "maxLength": 6 },
    "destinationslotnumber": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
    "blockstatus":       { "type": ["string", "null"], "maxLength": 30, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "linestate":         { "type": "string", "pattern": "^\\d{2}$" }
  }
}
