{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/stock-block.schema.json",
  "title": "1SL — Bloquear/Desbloquear stock (Host → KiSoft, 9801)",
  "description": "HISP §3.6.4. 41 añade bloqueo, 42 retira bloqueo. Filtra por artículo/tipo/lote/etc.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "requesttype", "blockreason"],
  "properties": {
    "mandtk":        { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "requesttype":   { "type": "string", "enum": ["41", "42"], "description": "41 = añadir, 42 = retirar." },
    "blockreason":   { "$ref": "https://knapp.local/schemas/common/block-reason.schema.json" },
    "filterlines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "station":       { "type": "string", "const": "065" },
          "geocode":       { "type": "string", "maxLength": 12 },
          "productnumber": { "type": "string", "maxLength": 12 },
          "packsize":      { "type": "string", "pattern": "^\\d{4}$" },
          "stocktype":     { "$ref": "https://knapp.local/schemas/common/stock-type.schema.json" },
          "batchnumber":   { "type": "string", "maxLength": 20 },
          "expirationdate":{ "type": "string", "format": "date" },
          "reservationcode":{ "type": "string", "maxLength": 10 },
          "loadunit":      { "type": "string", "maxLength": 8 },
          "slotnumber":    { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    }
  }
}
