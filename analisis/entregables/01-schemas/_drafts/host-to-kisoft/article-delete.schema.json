{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/article-delete.schema.json",
  "title": "14D — Borrar maestro de artículo (Host → KiSoft, 9801)",
  "description": "HISP §3.1.1.3. Si article existe con stock → estado 34. Sincronizado con 24D.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "productnumber", "packsize"],
  "properties": {
    "mandtk":        { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "productnumber": { "type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[A-Za-z0-9_-]+$" },
    "packsize":      { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^\\d{4}$" },
    "station":       { "type": ["string", "null"], "$ref": "https://knapp.local/schemas/common/station.schema.json", "description": "Vacío = todas las asignaciones; valor = solo esa estación." },
    "geocode":       { "type": ["string", "null"], "maxLength": 12, "description": "Vacío = por estación; valor = un único slot." }
  }
}
