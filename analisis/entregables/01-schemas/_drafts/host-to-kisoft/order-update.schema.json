{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/order-update.schema.json",
  "title": "12U — Modificar pedido (Host → KiSoft, 9801)",
  "description": "HISP §3.3.2. Solo modifica ruta teórica (F) o parámetros de control (O). Para pedidos pendientes siempre; para arrancados solo esos dos campos. Sincronizado con 22U.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "ordernumber", "sheetnumber"],
  "properties": {
    "mandtk":      { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "ordernumber": { "type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[A-Za-z0-9_-]+$" },
    "sheetnumber": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^\\d{4}$", "description": "0001..0999" },
    "route":       { "type": ["string", "null"], "maxLength": 8 },
    "clearcontrolparameters": {
      "type": "array",
      "maxItems": 99,
      "items": { "type": "string", "pattern": "^[0-9]{4}$" },
      "description": "Borra los estados de control listados (o)."
    },
    "controlparameters": {
      "type": "array",
      "maxItems": 99,
      "items": { "type": "string", "pattern": "^[0-9]{4}$" },
      "description": "Setea parámetros de control (O)."
    }
  }
}
