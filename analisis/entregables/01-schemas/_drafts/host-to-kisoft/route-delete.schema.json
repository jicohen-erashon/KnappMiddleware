{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/route-delete.schema.json",
  "title": "16D — Borrar ruta teórica (Host → KiSoft, 9801)",
  "description": "HISP §3.1.3.3. Sincronizado con 26D.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "route"],
  "properties": {
    "mandtk": { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "route":   { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
