{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/partner-delete.schema.json",
  "title": "15D — Borrar maestro de socio (Host → KiSoft, 9801)",
  "description": "HISP §3.1.2.3. Sincronizado con 25D (estado 50 si no existe).",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandtk", "partnernumber"],
  "properties": {
    "mandtk":        { "$ref": "https://knapp.local/schemas/common/mandante.schema.json" },
    "partnernumber": { "type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
