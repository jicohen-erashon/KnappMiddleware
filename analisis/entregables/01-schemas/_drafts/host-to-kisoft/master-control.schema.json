{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/host-to-kisoft/master-control.schema.json",
  "title": "Apertura/Cierre de transmisión de datos maestros (Host → KiSoft, 9801)",
  "description": "HISP §3.1.1.1 / §3.1.2.1 / §3.1.3.1. El identificador determina qué maestros: 140/141/149=artículos, 150/151/159=socios, 160/161/169=rutas. Las respuestas son 240/241/249, 250/251/259, 260/261/269.",
  "type": "object",
  "additionalProperties": false,
  "required": ["idrecord"],
  "properties": {
    "idrecord": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^[0-9]{3}$",
      "description": "Ver enums por dominio.",
      "oneOf": [
        { "const": "140", "description": "Crear todos los artículos (reemplazo total) → resp 240" },
        { "const": "141", "description": "Crear/borrar artículos individuales → resp 241" },
        { "const": "149", "description": "Cerrar transmisión de artículos → resp 249" },
        { "const": "150", "description": "Crear todos los socios → resp 250" },
        { "const": "151", "description": "Crear/borrar socios → resp 251" },
        { "const": "159", "description": "Cerrar transmisión de socios → resp 259" },
        { "const": "160", "description": "Crear todas las rutas → resp 260" },
        { "const": "161", "description": "Crear/borrar rutas → resp 261" },
        { "const": "169", "description": "Cerrar transmisión de rutas → resp 269" }
      ]
    },
    "domain": { "type": "string", "enum": ["ARTICLE","PARTNER","ROUTE"], "description": "Solo para legibilidad; el dominio lo decide el idrecord. Útil para validación cruzada." }
  }
}
