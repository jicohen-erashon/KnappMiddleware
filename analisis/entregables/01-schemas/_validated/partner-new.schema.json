{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/Envelope"
    },
    {
      "type": "object",
      "properties": {
        "idrecord": {
          "const": "15N"
        },
        "mandtk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "partner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "nameOrg1": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "nameOrg2": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "street": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "city1": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "city2": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "regioncode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6
        },
        "regionname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "postalcode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 2
        },
        "countryname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "maxLength": 30
        },
        "telephone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}$"
        },
        "titledescription": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        }
      },
      "required": [
        "idrecord",
        "mandtk",
        "partner"
      ]
    }
  ]
}
