{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/Envelope"
    },
    {
      "type": "object",
      "properties": {
        "idrecord": {
          "const": "1IA"
        },
        "mandtk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "inventorynumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "items": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "station": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{3}$"
              },
              "productnumber": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 12
              },
              "packsize": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}$"
              },
              "stocktype": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "STANDARD",
                  "B6",
                  "QQ",
                  "2F",
                  "1E",
                  "1X",
                  "1Z"
                ]
              },
              "batchnumber": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "loadunit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 8
              },
              "slotnumber": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{2}$"
              }
            }
          }
        }
      },
      "required": [
        "idrecord",
        "mandtk",
        "inventorynumber"
      ]
    }
  ]
}
