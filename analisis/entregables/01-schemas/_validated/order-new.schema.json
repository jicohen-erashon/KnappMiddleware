{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/Envelope"
    },
    {
      "type": "object",
      "properties": {
        "idrecord": {
          "const": "12N"
        },
        "mandtk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sheetnumber": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "ordernumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ordertype": {
          "type": "string",
          "pattern": "^(01|02|03|04|05|06|07|10|15|24|35|36)$"
        },
        "loadtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "loadunit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "businesspartner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "priority": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{3}$"
        },
        "texts": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 99
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stateqty",
              "state"
            ],
            "properties": {
              "stateqty": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "state": {
                "type": "string",
                "pattern": "^[0-9]{4}$"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productnumber",
              "packsize",
              "stocktype",
              "quantity"
            ],
            "properties": {
              "linereference": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "station": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{3}$"
              },
              "productnumber": {
                "type": "string",
                "maxLength": 12,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "packsize": {
                "type": "string",
                "pattern": "^[0-9]{4}$"
              },
              "stocktype": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "B6",
                  "QQ",
                  "2F",
                  "1E",
                  "1X",
                  "1Z"
                ]
              },
              "batchnumber": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "expirationdate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "stockquality": {
                "type": "string",
                "pattern": "^[12]$"
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 99
              },
              "loadtype": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "loadunit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 8
              }
            }
          }
        }
      },
      "required": [
        "idrecord",
        "mandtk",
        "sheetnumber",
        "ordernumber",
        "ordertype"
      ]
    }
  ]
}
