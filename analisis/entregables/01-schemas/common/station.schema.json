{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/common/station.schema.json",
  "title": "Número de estación KiSoft",
  "description": "Identificador numérico de tres dígitos (003) usado en prácticamente todos los registros. Ver tabla en HISP §4.1.5.11.",
  "type": "string",
  "minLength": 3,
  "maxLength": 3,
  "pattern": "^[0-9]{3}$",
  "anyOf": [
    { "description": "Estaciones manuales de preparación", "examples": ["001", "002", "003", "004"] },
    { "description": "Estaciones controladas / refrigeradas", "examples": ["010", "011"] },
    { "description": "OSR Shuttle™ (065) y flow racks (061, 244, 245)", "examples": ["061", "065", "244", "245"] },
    { "description": "Punto de arranque: OS001 (190), BULK001 (199)", "examples": ["190", "199"] },
    { "description": "Pick stations (041, 042)", "examples": ["041", "042"] },
    { "description": "Estación ST003_PUT artículos no reusables (017)", "examples": ["017"] },
    { "description": "Estaciones de control (CS001, CS002, CS001_1 out, GPA001, PA002)", "examples": ["083", "091", "092", "094", "095", "027"] },
    { "description": "Rampas de despacho (DIS001 = 183, DIS002 = 184)", "examples": ["183", "184"] }
  ]
}
