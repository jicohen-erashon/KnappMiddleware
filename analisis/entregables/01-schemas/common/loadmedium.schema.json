{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knapp.local/schemas/common/loadmedium.schema.json",
  "title": "Medio de carga (10 chars)",
  "description": "Token REGEX [A-Z][A-Z0-9_]*. HISP §4.1.5.5.",
  "type": "string",
  "minLength": 1,
  "maxLength": 10,
  "pattern": "^[A-Z][A-Z0-9_]*$",
  "oneOf": [
    { "const": "LARGE",      "description": "Caja de plástico grande (preparación por transportador)" },
    { "const": "CARTON",     "description": "Caja de cartón (preparación por transportador)" },
    { "const": "FULL",       "description": "Caja de almacenamiento 1/1 OSR Shuttle — 1 slot" },
    { "const": "HALF",       "description": "Caja de almacenamiento 2/2 OSR Shuttle — 2 slots" },
    { "const": "QUARTER",    "description": "Caja de almacenamiento 4/4 OSR Shuttle — 4 slots" },
    { "const": "EIGHTH",     "description": "Caja de almacenamiento 8/8 OSR Shuttle — 8 slots" }
  ]
}
